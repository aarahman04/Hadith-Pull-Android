<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash remains visible until settings load and displays the supplied app icon. -->
    <style name="Theme.HadithPull.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FCFBF0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/hadith_pull_adaptive_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#FCFBF0</item>
        <item name="postSplashScreenTheme">@style/Theme.HadithPull</item>
    </style>

    <style name="Theme.HadithPull" parent="@android:style/Theme.Material.Light.NoActionBar" />
</resources>
